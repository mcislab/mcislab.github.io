{% assign item = include.item %}
<li>
    {% if include.type == 'award' %}
        {% if item.award_url %}<a href="{{ item.award_url }}">{% endif %}
        {{ item.award }}
        {% if item.award_url %}</a>{% endif %}
        {% if item.description %} {{ item.description }}{% endif %}
        {% if item.venue %} at <a href="{{ item.venue_url }}">{{ item.venue }}</a>{% endif %}
        {% if item.extra_label %} (<a href="{{ item.extra_url }}">{{ item.extra_label }}</a>){% endif %}
    {% elsif include.type == 'event' %}
        <a href="{{ item.url }}">{{ item.name | default: item.event }}</a>, {{ item.date }}{% if item.address %} ({{ item.address }}){% endif %}
        {% if item.colocated_with %}, co-located with <a href="{{ item.colocated_url }}">{{ item.colocated_with }}</a>{% endif %}
        {% if item.hosted_by %}, graciously hosted by {{ item.hosted_by }}{% endif %}
    {% elsif include.type == 'chair' %}
        {{ item.role }} {% if item.cochair %}(together with <a href="{{ item.cochair_url }}">{{ item.cochair }}</a>){% endif %}
        {% if item.track %}for {{ item.track }}{% endif %} of the <a href="{{ item.url }}">{{ item.event }}</a>, {{ item.date }}{% if item.address %} ({{ item.address }}){% endif %}
        {% if item.extra_label %} [<a href="{{ item.extra_url }}">{{ item.extra_label }}</a>]{% endif %}
    {% elsif include.type == 'pc' %}
        {% if item.track %}{% if item.track_url %}<a href="{{ item.track_url }}">{% endif %}{{ item.track }}{% if item.track_url %}</a>{% endif %} track of the {% endif %}
        <a href="{{ item.url }}">{{ item.event }}</a>, {{ item.date }}{% if item.address %} ({{ item.address }}){% endif %}
        {% if item.colocated_with %}, co-located with <a href="{{ item.colocated_url }}">{{ item.colocated_with }}</a>{% endif %}
    {% elsif include.type == 'reviewing' %}
        <a href="{{ item.url }}">{{ item.name }}</a>{% if item.short_name %} ({{ item.short_name }}){% endif %}
    {% elsif include.type == 'editorship' -%}
        {%- if item.url and item.event == nil -%}
            <a href="{{ item.url }}">{{ item.role }}</a>
        {%- else -%}
            {{ item.role }}
        {%- endif -%}
        {%- if item.event %} of the <a href="{{ item.url }}">{{ item.event }}</a>{% endif -%}
        {%- if item.at_event %} at the <a href="{{ item.at_url }}">{{ item.at_event }}</a>{% endif -%}
        {%- if item.description %} {{ item.description }}{% endif -%}
        {%- if item.date %}, {{ item.date }}{% endif -%}
        {%- if item.address %} ({{ item.address }}){% endif -%}
    {% elsif include.type == 'talk' %}
        {% if item.slides_url %}<a href="{{ item.slides_url }}">{% endif %}{{ item.title }}{% if item.slides_url %}</a>{% endif %},
        {{ item.prefix | default: "Invited talk at" }}
        {% if item.url %}<a href="{{ item.url }}">{% endif %}{{ item.event }}{% if item.url %}</a>{% endif %}
        {% if item.address %}, {{ item.address }}{% endif %}, {{ item.date }}
        {% if item.extra_label %} <span class="pub-highlight">[{% if item.extra_url %}<a href="{{ item.extra_url }}">{% endif %}{{ item.extra_label }}{% if item.extra_url %}</a>{% endif %}]</span>{% endif %}
    {% elsif include.type == 'press' %}
        <a href="{{ item.url }}">{{ item.title }}</a>{% if item.extra_label %} (also <a href="{{ item.extra_url }}">{{ item.extra_label }}</a>){% endif %}
        {% if item.description or item.event %}, {{ item.description | default: item.event }}{% endif %}
        {% if item.date %}, {{ item.date }}{% endif %}
    {% endif %}
</li>
