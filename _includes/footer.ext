<!-- -*- engine:liquid -*- -->
<div class="callout"> 
    <div class="calloutcontainer"> 
        <div class="container_12"> 
            <div class="grid"> 
    <article class="latestgallery_left">
      <h2>Latest Work</h2>
      {% assign count = 0 %}
      {% assign latest_1 = nil %}
      {% assign latest_2 = nil %}
      {% assign latest_3 = nil %}
      {% assign latest_4 = nil %}
      
      {% for year_entry in site.data.publications %}
        {% assign types = year_entry[1] %}
        
        {% if types.journal %}
          {% for paper in types.journal %}
            {% assign count = count | plus: 1 %}
            {% capture paper_html %}
              <p>
               {% for author in paper.authors %}{% unless forloop.first %}{% if forloop.last %} and {% else %}, {% endif %}{% endunless %}{{ author }}{% endfor %} ({{ paper.year }}). <a href="{{ paper.url }}">{{ paper.title }}</a>, {{ paper.venue }}&nbsp;
             </p><br/>
            {% endcapture %}
            {% if count == 1 %}{% assign latest_1 = paper_html %}{% endif %}
            {% if count == 2 %}{% assign latest_2 = paper_html %}{% endif %}
            {% if count == 3 %}{% assign latest_3 = paper_html %}{% endif %}
            {% if count == 4 %}{% assign latest_4 = paper_html %}{% endif %}
            {% if count == 4 %}{% break %}{% endif %}
          {% endfor %}
        {% endif %}
        {% if count == 4 %}{% break %}{% endif %}
        
        {% if types.conference %}
          {% for paper in types.conference %}
            {% assign count = count | plus: 1 %}
            {% capture paper_html %}
              <p>
               {% for author in paper.authors %}{% unless forloop.first %}{% if forloop.last %} and {% else %}, {% endif %}{% endunless %}{{ author }}{% endfor %} ({{ paper.year }}). <a href="{{ paper.url }}">{{ paper.title }}</a>, {{ paper.venue }}&nbsp;
             </p><br/>
            {% endcapture %}
            {% if count == 1 %}{% assign latest_1 = paper_html %}{% endif %}
            {% if count == 2 %}{% assign latest_2 = paper_html %}{% endif %}
            {% if count == 3 %}{% assign latest_3 = paper_html %}{% endif %}
            {% if count == 4 %}{% assign latest_4 = paper_html %}{% endif %}
            {% if count == 4 %}{% break %}{% endif %}
          {% endfor %}
        {% endif %}
        {% if count == 4 %}{% break %}{% endif %}
      {% endfor %}

      {{ latest_1 }}
      {{ latest_2 }}
    </article>

    <article class="latestgallery">
      {{ latest_3 }}
      {{ latest_4 }}
    </article>
    
            <div class="clear"></div> 
        </div> 
        <div class="calloutoverlay"></div> 
        <div class="calloutoverlaybottom"></div> 
    </div> 
</div> </div> 
 <footer>
    <p class="tagline_left">Copyright &copy; {{ site.time | date_to_rfc822 }} - All Rights Reserved - <a href="http://mcis.queensu.ca.ca/">MCIS</a></p>
    <p class="tagline_right">Design by <a href="http://www.priteshgupta.com/" title="Pritesh Gupta" target="_blank" >PriteshGupta.com</a>, German Shepherd picture by <a href="http://www.sxc.hu/photo/1323938">Andrew Langham</a></p>
    <br class="clear" />
  </footer>

<br />
<br />
