{% assign p = include.pub %}
{% for author in p.authors %}{% unless forloop.first %}{% if forloop.last %} and {% else %}, {% endif %}{% endunless %}{{ author }}{% endfor %} ({{ p.year | default: site.data.current_year }}). <a href="{{ p.url }}">{{ p.title }}</a>{% if p.venue %}, {{ p.venue }}{% endif %}{% if p.address %} ({{ p.address }}){% endif %}{% if p.volume %}, {{ p.volume }}{% endif %}{% if p.number %}({{ p.number }}){% endif %}{% if p.pages %}, p. {{ p.pages }}{% endif %}{% if p.publisher %}, {{ p.publisher }}{% endif %}{% if p.status %}, {{ p.status }}{% endif %}.{% if p.acceptance_ratio %} (Acceptance ratio: {{ p.acceptance_ratio }}){% endif %}{% if p.award %}&nbsp;<span style="color: black; font-weight: bold">({{ p.award }})</span>{% endif %}{% if p.replication_package %}&nbsp;<span style="color: black; font-weight: bold">[<a href="{{ p.replication_package }}">replication package</a>]</span>{% endif %}{% if p.bibtex %}&nbsp;<a href="{{ p.bibtex }}"><i>BibTeX</i></a>{% endif %}
